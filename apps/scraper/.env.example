# ==========================================
# Database & Queue Configuration
# ==========================================
# MongoDB URI for lead storage
MONGO_URI=mongodb://localhost:27017/lead-intelligence
REDIS_URL=redis://localhost:6379

# ==========================================
# Enrichment & Scoring API Keys
# ==========================================
# Claude API Key for ICP Scoring
ANTHROPIC_API_KEY=your_anthropic_api_key

# Explorium API Key for email + phone enrichment (Tier 1 — highest priority)
# 3-step flow: match business → match prospect → enrich contacts
# Get it at: https://developers.explorium.ai/
EXPLORIUM_API_KEY=your_explorium_api_key

# Proxycurl API Key for LinkedIn enrichment
# Get it at: https://nubela.co/proxycurl/
PROXYCURL_KEY=your_proxycurl_key

# Hunter.io API Key for email finding
# Get it at: https://hunter.io/api_keys
HUNTER_KEY=your_hunter_api_key

# Apollo.io API Key for contact matching
# Get it at: https://www.apollo.io/
APOLLO_KEY=your_apollo_api_key

# Clearbit API Key for company enrichment
CLEARBIT_API_KEY=your_clearbit_api_key

# BuiltWith API Key for tech stack enrichment
# Get it at: https://builtwith.com/api
BUILTWITH_API_KEY=your_builtwith_api_key

# GeekFlare API Key
# Get it at: https://rapidapi.com/geekflare/
GEEKFLARE_API_KEY=your_geekflare_api_key

# ==========================================
# Scraper Configuration
# ==========================================
# Your active LinkedIn session cookie (li_at)
# Get this by logging into LinkedIn, opening DevTools -> Application -> Cookies -> li_at
LINKEDIN_SESSION_COOKIE=your_li_at_cookie

# Proxy URL to avoid IP bans (e.g. BrightData, Oxylabs)
PROXY_URL=http://user:pass@proxy.example.com:8080

# ==========================================
# App Configuration
# ==========================================
PORT=3000
NODE_ENV=development
DASHBOARD_URL=http://localhost:3000

# Secret for JWT and Webhook signing
JWT_SECRET=your_super_secret_jwt_string

# ==========================================
# AWS Credentials (for S3 Exports)
# ==========================================
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-export-bucket

# ==========================================
# Notifications
# ==========================================
# Slack webhook for campaign alerts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
